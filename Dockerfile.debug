# Simple debug Dockerfile
FROM node:18-alpine AS builder

# Increase memory limit
ENV NODE_OPTIONS="--max-old-space-size=4096"

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with verbose logging
RUN npm ci --silent --no-audit --no-fund

# Copy only necessary files
COPY src ./src
COPY public ./public
COPY assets ./assets
COPY optimized ./optimized
COPY preview-audio ./preview-audio
COPY images ./images
COPY index.html ./
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY tsconfig.node.json ./
COPY tailwind.config.js ./
COPY postcss.config.js ./

# Debug: List files
RUN ls -la

# Build with verbose output
RUN npm run build -- --mode production

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy static assets
COPY --from=builder /app/assets /usr/share/nginx/html/assets
COPY --from=builder /app/optimized /usr/share/nginx/html/optimized
COPY --from=builder /app/preview-audio /usr/share/nginx/html/preview-audio
COPY --from=builder /app/public /usr/share/nginx/html/public
COPY --from=builder /app/images /usr/share/nginx/html/images

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]